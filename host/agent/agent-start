#!/bin/bash
set -eo pipefail

TMPDIR=$(getconf DARWIN_USER_TEMP_DIR)
export HOME=@AGENT_HOME@ TMPDIR PATH=@ROOT@/code/bin:/usr/bin:/bin:/usr/sbin:/sbin
export OMP_AUTH_BROKER_URL=http://127.0.0.1:@USAGE_BROKER_PORT@ OMP_AUTH_BROKER_TOKEN=usage-only
export GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=credential.https://github.com.helper GIT_CONFIG_VALUE_0= GIT_CONFIG_KEY_1=credential.https://github.com.helper GIT_CONFIG_VALUE_1='!f() { t=$("@ROOT@/code/bin/gh-app-token") || exit 1; echo username=x-access-token; echo "password=$t"; }; f'

root=@ROOT@
code=$root/code
agent=$HOME/.omp/agent

die() {
  printf 'agent-start: %s\n' "$*" >&2
  exit 1
}

[[ -r $root/gateway-token ]] || die "cannot read $root/gateway-token; the owner runs host/bin/ug-setup"
export UG_GATEWAY_TOKEN=$(<"$root/gateway-token")
[[ -n $UG_GATEWAY_TOKEN ]] || die "$root/gateway-token is empty; the owner runs host/bin/ug-setup"

omp_bin=$(readlink "$code/bin/omp") || die "no $code/bin/omp; the owner runs host/bin/ug-setup"

# The agent's ssh login has no desktop session, so macOS logs failed text-checking and spell-server lookups to stderr.
# grep ignores SIGINT so that a Ctrl-C cannot close omp's stderr.
start_omp() {
  { "$omp_bin" "$@" 2>&1 1>&3 3>&- | { trap '' INT; /usr/bin/grep --line-buffered -v -F -e 'dataFromCheckingString received error' -e 'Spell server connection invalidated' >&2 || true; }; } 3>&1
  exit 0
}

for dir in "$HOME/.omp" "$agent"; do
  if [[ -L $dir || ( -e $dir && ! -d $dir ) ]]; then rm -f "$dir"; fi
  mkdir -p "$dir"
done

if [[ -z ${UG_REPO:-} ]]; then
  mkdir -p "$HOME/scratch"
  cd "$HOME/scratch"
  start_omp "$@"
fi
[[ $UG_REPO =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "UG_REPO has a value that is not owner/name"

clone=$HOME/work/$UG_REPO
new_clone=
if [[ ! -d $clone/.git ]]; then
  rm -rf "$clone"
  mkdir -p "$clone"
  git -C "$clone" init -q
  git -C "$clone" remote add origin "https://github.com/$UG_REPO.git"
  new_clone=1
fi
cd "$clone"

fetch_status=0
/usr/bin/lockf -k -t 30 .git/ug-sync.lock git fetch --quiet --no-tags origin || fetch_status=$?
(( fetch_status != 75 )) || die "another session holds the fetch of $UG_REPO for over 30 s; start the session again in a moment"
(( fetch_status == 0 )) || {
  printf 'agent-start: git fetch origin for %s failed: is the GitHub App installed on it, and does GitHub answer?\n' "$UG_REPO" >&2
  exit 69
}
base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD) || base=
if [[ -z $base ]]; then
  git remote set-head origin --auto >/dev/null 2>&1 || true
  base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD) || base=
fi
[[ -n $base ]] || {
  printf 'agent-start: cannot read the default branch of %s from GitHub\n' "$UG_REPO" >&2
  exit 69
}

# A new clone gets one checkout so that it has files and an index. No session works in the clone itself.
if [[ -n $new_clone ]]; then
  git checkout -q --detach "$base" || die "the new clone of $UG_REPO cannot check out $base; is that repository empty?"
fi

# Each session starts in a fresh worktree at the current base, so no stale file of an earlier session
# carries into it. The name of a worktree starts with its start time, so names sort by age.
trees=$HOME/work/.wt/$UG_REPO
stamp=$(/bin/date +%Y%m%d-%H%M%S)-$$
cutoff=$(/bin/date -v-1d +%Y%m%d-%H%M%S)
mkdir -p "$trees"
for old in "$trees"/*; do
  [[ -d $old ]] || continue
  # A worktree goes only when it is older than a day, has no changes, and has no commit that is not on GitHub.
  [[ ${old##*/} < "$cutoff" ]] || continue
  [[ -z $(git -C "$old" status --porcelain 2>/dev/null) ]] || continue
  [[ -z $(git -C "$old" rev-list -n 1 HEAD --not --remotes 2>/dev/null) ]] || continue
  git worktree remove "$old" >/dev/null 2>&1 || true
done
git worktree prune
git -c core.hooksPath=/dev/null worktree add -q --detach "$trees/$stamp" "$base" ||
  die "cannot make a worktree of $UG_REPO at $base in $trees/$stamp"
cd "$trees/$stamp"
start_omp "$@"
